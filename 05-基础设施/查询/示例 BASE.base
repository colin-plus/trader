formulas:
  自定义字段: created
  "": |
    tags
properties:
  formula.:
    displayName: 自定义
views:
  - type: table
    name: 表格
    filters:
      and:
        - and:
            - type == "学习笔记"
            - read_status == "读完"
    order:
      - file.name
      - formula.
    sort:
      - property: formula.
        direction: ASC
